# =============================================================================
# Backend (Render / local Docker)
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Hackathon API
API_V1_PREFIX=/api/v1

# PostgreSQL — use Supabase/Neon connection string with async driver:
# postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hackathon

SECRET_KEY=change-me-to-a-random-string-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated origins for split deploy (Vercel frontend URL in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider: openai | groq | anthropic | mock
AI_PROVIDER=mock
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=


# =============================================================================
# Frontend (Vercel / local Vite) — prefix with VITE_
# =============================================================================
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
